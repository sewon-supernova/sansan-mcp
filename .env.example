# Sansan Open API key (32 alphanumeric characters)
# Issue from: https://www.sansan.com → Settings → API → Open API
SANSAN_API_KEY=

# Optional: Sansan Partner Program App ID
# Only required if your integration is registered as a Sansan partner
# SANSAN_APP_ID=

# Optional: override API base URL (defaults to https://api.sansan.com/v6.0)
# SANSAN_BASE_URL=
